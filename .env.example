# Logging Configuration
# Log level: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# Server Configuration
# PORT=5000
# SHUTDOWN_TIMEOUT_MS=15000

# CORS Configuration (comma-separated origins, empty = allow all)
# CORS_ORIGINS=https://example.com,https://app.example.com

# Rate Limiting
# RATE_LIMIT_WINDOW_MS=1000
# RATE_LIMIT_MAX=50

# AWS Configuration (for S3 storage)
# AWS region for S3 bucket
AWS_REGION=us-east-1
# AWS access key ID (optional if using IAM roles)
AWS_ACCESS_KEY_ID=***
# AWS secret access key (optional if using IAM roles)
AWS_SECRET_ACCESS_KEY=***

# S3 Storage Configuration
# S3 bucket name for tile storage
S3_BUCKET=maptile-cache
# S3 endpoint URL (for MinIO or other S3-compatible services)
S3_ENDPOINT=http://localhost:9000
# S3 prefix/path for tile storage (default: tiles)
S3_PREFIX=test-cache

# Memory Cache Configuration
# MEMORY_CACHE_MAX_SIZE=1000
# MEMORY_CACHE_TTL_MS=300000
# MEMORY_CACHE_MAX_BYTES=268435456
